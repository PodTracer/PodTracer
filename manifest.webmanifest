{
  "id": "PodTracer/app",
  "name": "Pod Tracer",
  "short_name": "Pod Tracer",
  "description": "Track the podcast episodes you've listened to.",
  "start_url": "./index.html?app=1",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#efeadf",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
